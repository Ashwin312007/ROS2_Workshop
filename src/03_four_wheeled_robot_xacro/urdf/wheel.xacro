<?xml version="1.0"?>
<!--
  Stage 3: reusable `wheel` macro.

  Calling <xacro:wheel name="..." parent="..." x_offset=... y_offset=...
  z_offset=.../> expands to one continuous joint plus one cylinder link, so
  all four wheels stay geometrically identical by construction.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- name: prefix for the joint/link names (e.g. front_left_wheel).
       parent: chassis link the wheel hangs off.
       *_offset: mounting position of the wheel centre in the parent frame. -->
  <xacro:macro name="wheel" params="name parent x_offset y_offset z_offset">
    <joint name="${name}_joint" type="continuous">
      <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <!-- Rotate about local Y: the wheel axle points sideways. -->
      <axis xyz="0 1 0"/>
      <!-- No position limits (continuous); only effort/velocity caps. -->
      <limit effort="10.0" velocity="20.0"/>
    </joint>

    <link name="${name}_link">
      <!-- URDF cylinders are built along Z, so roll by 90 deg to align the
           cylinder axis with the joint's Y rotation axis. -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi_val/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi_val/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
  </xacro:macro>
</robot>
