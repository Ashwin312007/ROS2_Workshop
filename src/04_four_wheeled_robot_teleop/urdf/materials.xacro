<?xml version="1.0"?>
<!--
  Stage 4: named RGBA colours shared by chassis.xacro and wheel.xacro.

  Materials are looked up by name from the <visual> tags, so the chassis
  colour can be changed here without touching the geometry.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.42 0.04 1.0"/>
  </material>
</robot>
