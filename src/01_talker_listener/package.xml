<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- Stage 1: minimal Python pub/sub package. -->
  <name>talker_listener</name>
  <version>0.0.1</version>
  <description>Minimal ROS 2 publisher and subscriber package in Python</description>
  <maintainer email="user@todo.todo">User</maintainer>
  <license>Apache-2.0</license>

  <!-- Run-time dependencies: the rclpy client library and the String message. -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- Linters/test dependencies used by `colcon test`. -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <!-- ament_python: built by setup.py, not CMake. -->
    <build_type>ament_python</build_type>
  </export>
</package>
